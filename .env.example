# Copy to .env and set local passwords. Never commit .env.
POSTGRES_USER=station
POSTGRES_PASSWORD=replace-with-local-db-password
POSTGRES_DB=digital_station
POSTGRES_PORT=55432
DATABASE_URL=postgresql+psycopg://station:replace-with-local-db-password@127.0.0.1:55432/digital_station
TEST_DATABASE_URL=postgresql+psycopg://station:replace-with-local-db-password@127.0.0.1:55432/digital_station_h0_test
DEMO_VIEWER_PASSWORD=replace-with-local-viewer-password
DEMO_OPERATOR_PASSWORD=replace-with-local-operator-password
DEMO_DISPATCHER_PASSWORD=replace-with-local-dispatcher-password
DEMO_ADMIN_PASSWORD=replace-with-local-admin-password
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://localhost:5173,http://127.0.0.1:5173
